# ==========================================
# ASCI Academy — Environment Configuration
# ==========================================

# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Identity Services (GIS) / Google One Tap Client ID
# Found in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client
# Required for genuine Canva-style Google One Tap account chooser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Secret (Stored in Supabase Dashboard under Authentication -> Providers -> Google)
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Gemini AI Assistant (Axel & R4X)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional Email / SMTP configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
