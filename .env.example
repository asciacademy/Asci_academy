# Site Domain Configuration
NEXT_PUBLIC_SITE_URL=https://asci-academy.pages.dev

# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Identity Services (GIS) / Google One Tap Client ID
# Found in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client
# Required for genuine Canva-style Google One Tap account chooser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Secret (Stored in Supabase Dashboard under Authentication -> Providers -> Google)
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Gemini AI Assistant (Axel & R4X)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# AWS DynamoDB — Payment Order Storage
# Found in: AWS Console -> IAM -> Security credentials
# Required: Create a DynamoDB table named "asci-payment-orders" with PK "orderId" (String)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_DYNAMODB_TABLE=asci-payment-orders

# UPI & Razorpay Payment Gateway Configuration
# Replace with your actual UPI ID registered with your bank
NEXT_PUBLIC_UPI_ID=your_upi_id@bank
NEXT_PUBLIC_UPI_NAME=ASCI Academy

# Razorpay API Credentials (Test or Production key from Razorpay Dashboard)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional Feature Toggles
# NEXT_PUBLIC_DISABLE_GOOGLE_ONE_TAP=false

# Optional Email / SMTP configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

